# Copiar a .env para desarrollo local. Nunca versionar el .env real.
# En Coolify estas variables se cargan en Environment Variables, no en Git.

ENV=local
DATABASE_URL=postgresql+psycopg://ica:ica_local@localhost:5432/ica
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:8080

# Migraciones automáticas al arrancar (0 en producción, 1 solo en local o una única instancia)
RUN_MIGRATIONS=0

# Almacenamiento de objetos (opcional hasta que exista el módulo de imágenes)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
