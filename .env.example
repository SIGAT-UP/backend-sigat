# =============================================================================
# Variables de entorno de sigat-durazno-api.
# Copie este archivo a `.env` (que está en .gitignore) y complete los valores.
# NINGÚN valor real va en este archivo: solo nombres y ejemplos inofensivos.
# Prefijo común: SIGAT_
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
SIGAT_ENTORNO=desarrollo                 # desarrollo | pruebas | produccion
SIGAT_DEPURACION=false
SIGAT_PREFIJO_API=/api/v1
SIGAT_ZONA_HORARIA_PREDETERMINADA=America/Bogota
# Versión mínima de la app móvil aceptada (cabecera X-App-Version). Vacío = sin control.
SIGAT_VERSION_MINIMA_APP=

# --- Base de datos SIGAT v9 (PostgreSQL 16 + PostGIS 3.4 + btree_gist) -------
# Desarrollo local: el mismo usuario y clave de SIGAT_DB_ADMIN_* (docker compose) o los de su PostgreSQL.
# Producción: un usuario de APLICACIÓN, no superusuario ni dueño del esquema.
SIGAT_DB_URL=postgresql+asyncpg://sigat_admin:CAMBIAR@localhost:5432/sigat
SIGAT_DB_ESQUEMA=sigat
SIGAT_DB_POOL_TAMANO=10
SIGAT_DB_POOL_EXTRA=5
SIGAT_DB_TIMEOUT_SENTENCIA_MS=15000
# Solo para generar tablas con sqlacodegen (driver síncrono):
SIGAT_DB_URL_SYNC=postgresql+psycopg://USUARIO_APP:CAMBIAR@localhost:5432/sigat
# Solo docker-compose de desarrollo (superusuario del contenedor de BD):
SIGAT_DB_ADMIN_USUARIO=sigat_admin
SIGAT_DB_ADMIN_CLAVE=CAMBIAR

# --- Seguridad: tokens ----------------------------------------------------------
# Genere con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SIGAT_JWT_SECRETO=CAMBIAR
SIGAT_JWT_ALGORITMO=HS256
SIGAT_JWT_EMISOR=sigat-durazno-api
SIGAT_JWT_AUDIENCIA=sigat-durazno
SIGAT_TOKEN_ACCESO_MINUTOS=15
SIGAT_TOKEN_REFRESCO_DIAS_WEB=1
SIGAT_TOKEN_REFRESCO_DIAS_MOVIL=30
SIGAT_RECUPERACION_MINUTOS=30
# Límite de intentos fallidos de inicio de sesión (por usuario y por IP) dentro de la ventana.
SIGAT_LOGIN_MAX_FALLOS_USUARIO=5
SIGAT_LOGIN_MAX_FALLOS_IP=30
SIGAT_LOGIN_VENTANA_MINUTOS=15

# --- Web: CORS y cookie del token de refresco --------------------------------
# Orígenes de la web (lista JSON). Con el proxy de Vite (npm run dev) no hace falta CORS,
# pero se deja el origen de desarrollo por si la web llama directo al API.
SIGAT_CORS_ORIGENES=["http://localhost:5173"]
SIGAT_COOKIE_REFRESCO_NOMBRE=sigat_refresco
# true en producción (HTTPS). false SOLO en desarrollo local por http.
SIGAT_COOKIE_SEGURA=false
SIGAT_COOKIE_DOMINIO=

# --- Proveedor de identidad institucional (RI-008). Vacío = solo cuentas locales
SIGAT_OIDC_EMISOR=
SIGAT_OIDC_CLIENTE_ID=
SIGAT_OIDC_CLIENTE_SECRETO=

# --- Almacenamiento de objetos (S3 compatible; MinIO en desarrollo) -----------
SIGAT_S3_ENDPOINT=http://localhost:9000
SIGAT_S3_REGION=us-east-1
SIGAT_S3_BUCKET=sigat-durazno-evidencia
SIGAT_S3_ACCESO=CAMBIAR
SIGAT_S3_SECRETO=CAMBIAR
SIGAT_S3_URL_FIRMADA_SEGUNDOS=600
SIGAT_ARCHIVO_MAX_IMAGEN_MB=8
SIGAT_ARCHIVO_MAX_DOCUMENTO_MB=10

# --- Cola de trabajo (reproceso de MTD y concepto) ----------------------------
# Usa la misma base PostgreSQL en el esquema `cola` (no es un servicio aparte).
SIGAT_COLA_ESQUEMA=cola
SIGAT_COLA_CONCURRENCIA=2

# --- Sincronización -------------------------------------------------------------
SIGAT_SYNC_MAX_OPERACIONES_POR_LOTE=200
SIGAT_SYNC_UMBRAL_DERIVA_RELOJ_SEG=300

# --- Correo (recuperación de contraseña) ----------------------------------------
SIGAT_SMTP_HOST=
SIGAT_SMTP_PUERTO=587
SIGAT_SMTP_USUARIO=
SIGAT_SMTP_CLAVE=
SIGAT_SMTP_REMITENTE=

# --- Observabilidad -------------------------------------------------------------
SIGAT_LOG_NIVEL=INFO
SIGAT_LOG_FORMATO=json                    # json | consola
